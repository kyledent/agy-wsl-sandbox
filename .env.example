# agybox settings. ./agybox copies this to .env on first run. Variables set in your shell win over this file:
#   AGYBOX_NETWORK=learn ./agybox

# How agy is contained:
#   bwrap      bubblewrap, with the tools of this WSL Ubuntu, read-only. Nothing to build. (default)
#   docker     a container from container/Dockerfile. Needs Docker Desktop's WSL integration, or docker-ce
#   apptainer  a rootless container from container/agybox.def. Needs apptainer
AGYBOX_BACKEND=bwrap

# Where agy can go on the network:
#   proxy   only the hosts in allow/hosts.txt and allow/local.txt, through a filtering proxy (default)
#   learn   any public host, through the proxy, which logs them all. Then ./agybox hosts all
#   none    nowhere: agy cannot reach its models, but shell and tools work offline
#   open    WSL's own network: the internet, your LAN, any VPN, and in mirrored mode Windows' localhost
AGYBOX_NETWORK=proxy

# The one project agy may read and write. Not your home, and not a folder that holds this one.
WORKSPACE_DIR=./workspace

# Variables from your shell to pass into the sandbox, separated by commas. Anything listed here, the agent can read
# and send to any host it can reach. Leave GH_TOKEN unset unless you need it.
AGYBOX_PASS_ENV=GH_TOKEN

# agy's tool execution policy, applied at every start: always-proceed, request-review, proceed-in-sandbox or strict.
# Empty leaves agy's own setting, which /permissions in agy changes.
AGY_TOOL_EXECUTION_POLICY=

# Limits, empty for none. Memory as 8G, CPUs as 4 or 1.5, PIDs as 2048. For bwrap and apptainer they need systemd
# in WSL (systemd=true in /etc/wsl.conf, the default on Ubuntu 24.04).
AGYBOX_MEMORY=
AGYBOX_CPUS=
AGYBOX_PIDS=

# bwrap only: 1 turns off user namespaces inside the sandbox. That also breaks agy, which runs each command in a
# sandbox of its own: they fail with "no space left on device". Only for ./agybox shell or run without agy.
AGYBOX_DISABLE_USERNS=0
